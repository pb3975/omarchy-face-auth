+    }
+  }
+
+  function handleFaceFinished(result) {
+    faceAuthenticating = false
+
+    if (!lockRequested) return
+    if (result === PamResult.Success) {
+      finishUnlock()
+    } else if (faceConfigured && faceAttempts < faceAttemptBudget) {
+      faceRetryTimer.restart()
+    }
+  }
+
+  // Hands the camera a fresh budget once the opening burst has run out. A
+  // password check in flight already owns the unlock, so it is left to finish
+  // rather than raced -- typing is always the way through.
+  function rearmFace() {
+    if (!lockRequested || !faceConfigured || authenticatingPassword) return
+
+    faceAttempts = 0
+    faceRetryTimer.stop()
