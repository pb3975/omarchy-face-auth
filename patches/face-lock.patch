-        anchors.rightMargin: inputField.borderRight + 18 + root.fingerprintReserve
+        // Reserve the hint icons' width on both sides so the centered dots stay
+        // symmetric and never slide under an icon as they grow.
+        anchors.rightMargin: inputField.borderRight + 18 + root.fingerprintReserve + root.faceReserve
         anchors.bottomMargin: inputField.borderBottom
-        anchors.leftMargin: inputField.borderLeft + 18 + root.fingerprintReserve
+        anchors.leftMargin: inputField.borderLeft + 18 + root.fingerprintReserve + root.faceReserve
         verticalAlignment: TextInput.AlignVCenter
