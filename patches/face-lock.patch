# Adds a Howdy IR face-auth path to the Omarchy lock plugin, alongside the
# built-in password and fingerprint PAM flows.
#
# Generated against the upstream files listed in patches/UPSTREAM_SHA256.
# Re-apply after an Omarchy update with:
#
#   cp /usr/share/omarchy/shell/plugins/lock/{Service,LockView}.qml .
#   patch -p1 <patches/face-lock.patch
#
