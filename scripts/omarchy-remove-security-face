#!/bin/bash

# omarchy:summary=Remove face authentication from sudo, polkit, and lock screen
# omarchy:requires-sudo=true

set -euo pipefail


# Drop every pam_howdy line, and drop a clamshell gate only where it is ours —
# meaning the line directly beneath it is the pam_howdy line it was written to
# protect. A gate sitting above pam_fprintd belongs to fingerprint and has to
# survive, otherwise removing face auth silently breaks fingerprint's
# lid-closed fallback in the same file.
#
# (omarchy-remove-security-fingerprint has the mirror image of this bug: it
# deletes every omarchy-hw-laptop-closed line in the file, ours included. Not
# our script to fix, but it means running `omarchy remove security fingerprint`
# on a machine with face auth configured will strip our gate and leave
# pam_howdy ungated. Re-running setup puts it back.)
strip_face_awk='
  /omarchy-hw-laptop-closed/ {
    # Two gates in a row means the first one guards the second, not a module
    # of ours, so it stays.
    if (pending != "") print pending
    pending = $0
    next
  }
  /pam_howdy\.so/ {
    # The module goes, and so does the gate held above it, if any.
    pending = ""
    next
  }
  {
    if (pending != "") { print pending; pending = "" }
    print
  }
  END { if (pending != "") print pending }
'

strip_face_from() {
  local file="$1" label="$2"

  sudo grep -q 'pam_howdy\\.so' "$file" 2>/dev/null || return 0

  echo "Removing face authentication from ${label}..."

  # Keep the full read/transform/validate/publish transaction inside one root
  # process. The candidate is root-created beside the target and published by
  # an atomic same-filesystem rename, so no user-writable temporary path ever
  # crosses the privilege boundary.
  sudo bash -c '
    set -euo pipefail
    file=$1
    program=$2
    dir=$(dirname -- "$file")
    base=$(basename -- "$file")
    tmp=$(mktemp -- "$dir/.${base}.face-auth.XXXXXX")

    cleanup() { rm -f -- "$tmp"; }
    trap cleanup EXIT HUP INT TERM

    awk "$program" "$file" >"$tmp"

    if grep -q "pam_howdy\\.so" "$tmp"; then
      echo "Refusing to publish PAM rewrite: pam_howdy.so is still present in $file" >&2
      exit 1
    fi

    # Preserve the original owner/group/mode plus any ACLs and xattrs without
    # copying the original contents over the transformed candidate.
    cp --attributes-only --preserve=all -- "$file" "$tmp"
    mv -f -- "$tmp" "$file"
    trap - EXIT HUP INT TERM
  ' _ "$file" "$strip_face_awk"
}

remove_pam_config() {
  strip_face_from /etc/pam.d/sudo sudo
  [[ -f /etc/pam.d/polkit-1 ]] && strip_face_from /etc/pam.d/polkit-1 polkit
  return 0
}

remove_lock_face_pam() {
  if [[ -f /etc/pam.d/omarchy-lock-face ]]; then
    echo "Removing lock screen face authentication..."
    # The lock plugin polls for this file, so deleting it is what turns the
    # face path off there — no shell restart needed.
    sudo rm -f /etc/pam.d/omarchy-lock-face
  fi
}


echo -e "\e[32mRemoving IR camera from authentication.\n\e[0m"

remove_pam_config
remove_lock_face_pam

echo "Removing face packages..."
# Enrolled face models under /etc/howdy stay on disk, orphaned — same posture
# as removing fingerprint, which leaves enrolled prints in /var/lib/fprint.
# `sudo howdy clear` wipes them, but that's the user's call, not a side effect
# of unwiring PAM.
omarchy-pkg-drop howdy-next
sudo systemctl daemon-reload

echo -e "\e[32mFace authentication has been completely removed.\e[0m"
